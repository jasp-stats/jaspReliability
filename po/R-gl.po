msgstr ""
"Gráficas de liñas de reborde que amosan a distribución posterior de cada "
"coeficiente de fiabilidade cando se quita cada elemento."

msgid "Bayesian Scale Reliability Statistics"
msgstr "Estatísticos baiesianos de fiabilidade de escala"

#, fuzzy
msgid "Posterior mean"
msgstr "Media Posterior"

#, fuzzy
msgid "Posterior median"
msgstr "Media Posterior"

msgid "R-hat"
msgstr "R-circunflexo"

msgid "Please assign at least two factors with at least two items each."
msgstr ""

msgid ""
"McDonald's ωₕ is shown only for the second-order and bi-factor models, not "
"the correlated-factors model."
msgstr ""

