msgstr "الحد السفلي لفترة الثقة 90%% لـSRMR"

msgid "SRMR 90%% CI upper"
msgstr "الحد العلوي لفترة الثقة 90%% لـSRMR"

msgid "SRMR p-value"
msgstr "قيمة p لـSRMR"

