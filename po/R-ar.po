msgstr "الحد السفلي لفترة الثقة 90%% لـRMSEA"

msgid "RMSEA 90%% CI upper"
msgstr "الحد العلوي لفترة الثقة 90%% لـRMSEA"

msgid "RMSEA p-value"
msgstr "قيمة p لـRMSEA"

msgid "AIC"
msgstr "AIC"

msgid "BIC"
msgstr "BIC"

